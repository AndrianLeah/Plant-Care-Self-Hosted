# Server .env.example
#
# This file is for running the Bun API directly from server/.
# It is NOT the same thing as the repository-root .env.example used by
# docker-compose and the frontend Docker build.

# HTTP port for the API.
PORT=3000

# SQLite database file path for direct local runs.
# Using a dedicated local file avoids mutating the checked-in plant-care.db.
# The Docker container overrides this to /data/plant-care.db.
DB_PATH=./local-plant-care.db

# Required JWT secrets.
# Generate strong random values with:
#   openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Required admin secret for X-Admin-Secret on /admin/* routes.
ADMIN_SECRET=

# Comma-separated browser origins allowed by the backend.
#
# Common values:
# - Web dev only:             http://localhost:1420
# - Web dev + Tauri:          http://localhost:1420,tauri://localhost
# - Local docker-compose:     http://localhost
# - Remote deploy:            https://yourdomain.com
CORS_ORIGIN=http://localhost:1420
