PORT=3000

# Path to the SQLite database file.
# When running with Docker, mount a volume at /data and leave this as-is.
DB_PATH=./plant-care.db

# Generate strong random secrets (required — server will refuse to start without them):
#   openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Protects admin endpoints (POST/PATCH/DELETE on /admin/*).
# Also required — generate the same way.
ADMIN_SECRET=

# Comma-separated list of allowed CORS origins.
# Tauri desktop:  tauri://localhost
# Web deploy:     https://yourdomain.com
# Development:    http://localhost:1420
CORS_ORIGIN=http://localhost:1420
