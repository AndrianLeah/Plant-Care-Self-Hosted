{
  "name": "plant-care-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate && bun run db:seed && bun run dev:watch",
    "dev:watch": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.5",
    "jose": "^5.10.0",
    "sqlite-gui-node": "^1.4.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.0"
  }
}
