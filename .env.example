# Frontend env example
#
# This file is for the repository root frontend only.
# It is read by:
# - Vite in local frontend development
# - the frontend Docker build
#
# Backend runtime variables belong in server/.env instead.
#
# This value is baked into the frontend bundle at build time.
# Common values:
# - Local Bun API:            http://localhost:3000
# - Local docker-compose:     http://localhost/api
# - Remote deploy:            https://yourdomain.com/api
VITE_API_URL=http://localhost/api
