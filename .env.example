# ── Required ──────────────────────────────────────────────────────────────────

# Secret key used to sign JWT access tokens (min 32 random chars)
JWT_SECRET=change_me_to_a_long_random_secret

# Secret key used to sign JWT refresh tokens (different from JWT_SECRET)
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret

# Secret header value for admin endpoints (e.g. X-Admin-Secret)
ADMIN_SECRET=change_me_admin_secret

# Public URL where the API is reachable FROM the browser
# When using the Nginx reverse proxy this should be:  http://<VPS_IP>/api
VITE_API_URL=http://<VPS_IP>/api

# Comma-separated list of allowed CORS origins (must match what the browser sends)
CORS_ORIGIN=http://<VPS_IP>
